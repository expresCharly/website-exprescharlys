# Copia este archivo a .env.local y completa los datos de Connect / API Keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Alternativa para proyectos con clave pública anon antigua:
# VITE_SUPABASE_ANON_KEY=

# Solo para el script local que carga fotos a Storage. Nunca usar prefijo VITE_.
# SUPABASE_SECRET_KEY=
